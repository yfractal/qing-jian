<% content_for :title, "Edit Flash Card" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "book_plugin/books", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "book_plugin/flash_card_preview_parent", defer: true %>
<% end %>

<main class="remember-page books-page">
  <header class="remember-header">
    <div>
      <p class="eyebrow">Flash Card</p>
      <h1>Edit · <%= @book.title %></h1>
    </div>
    <div class="remember-header-actions">
      <%= link_to "All flash cards", book_flash_cards_path(@book), class: "button button-secondary" %>
      <%= link_to "Back to book", book_path(@book), class: "button button-secondary" %>
    </div>
  </header>

  <% if flash.now[:alert].present? %>
    <p class="flash flash-alert" role="alert"><%= flash.now[:alert] %></p>
  <% end %>

  <%= render "form", book: @book, flash_card: @flash_card, book_html: @book_html %>
</main>
