<% return unless book_html.present? %>

<section class="book-card">
  <h2><%= flash_card.persisted? ? "Edit flash card" : "2) Create flash card" %></h2>
  <iframe
    class="book-html-preview-frame"
    title="Book page HTML preview"
    sandbox="allow-scripts"
    srcdoc="<%= h(book_html.rendered_html) %>">
  </iframe>

  <%= form_with model: [book, flash_card], local: true do |f| %>
    <%= f.hidden_field :book_html_id, value: book_html.id %>

    <%= f.label :areas_to_show, "Areas to show (JSON)" %>
    <%= text_area_tag "flash_card[areas_to_show]", flash_card.areas_to_show.to_json, id: "flash_card_areas_to_show", rows: 5 %>

    <%= label_tag "flash_card_items_to_remember_text", "Items to remember (one per line)" %>
    <%= text_area_tag "flash_card[items_to_remember_text]", flash_card.items_to_remember.join("\n"), id: "flash_card_items_to_remember_text", rows: 5 %>

    <%= f.submit(flash_card.persisted? ? "Update flash card" : "Create flash card", class: "button button-primary") %>
  <% end %>
</section>
