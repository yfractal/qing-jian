<% content_for :title, "New book" %>

<main class="remember-page books-page">
  <header class="remember-header">
    <div>
      <p class="eyebrow">Library</p>
      <h1>New book</h1>
    </div>
    <div class="remember-header-actions">
      <%= link_to "All books", books_path, class: "button button-secondary" %>
    </div>
  </header>

  <% if flash.now[:alert].present? %>
    <p class="flash flash-alert" role="alert"><%= flash.now[:alert] %></p>
  <% end %>

  <section class="book-card">
    <%= render "form", book: @book %>
  </section>
</main>
