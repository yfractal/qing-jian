<% content_for :title, "Word flash remember" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "book_plugin/books", "data-turbo-track": "reload" %>
<% end %>

<main class="remember-page books-page flash-card-remember-page word-flash-remember-page">
  <header class="remember-header">
    <div>
      <p class="eyebrow">Daily Review</p>
      <h1>Word flash remember</h1>
      <p>Recall the meaning, then rate how well you remembered.</p>
    </div>
    <div class="remember-header-actions">
      <%= link_to "Multiple choice review", multiple_choice_review_path, class: "button button-secondary" %>
      <%= link_to "All words", words_path, class: "button button-secondary" %>
      <% if @word.present? %>
        <%= link_to "Edit word", edit_word_path(@word), class: "button button-secondary" %>
      <% end %>
    </div>
  </header>

  <section class="remember-progress-card">
    <p class="eyebrow">Remember Progress</p>
    <p class="remember-progress-main">Remembered <%= @remembered_count %> / <%= @remember_total_count %></p>
    <p class="remember-progress-meta">Need to remember <%= @remaining_count %></p>
    <div class="remember-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @progress_percent %>">
      <div class="remember-progress-fill" style="width: <%= @progress_percent %>%"></div>
    </div>
  </section>

  <% if @word.present? %>
    <% flash_example_sentence = @word.example_sentence.to_s.strip %>
    <% flash_has_example = flash_example_sentence.present? %>
    <section class="recall-card flash-card-study-card">
      <section class="recall-layout" aria-label="Word flash study">
        <div class="recall-main">
          <p class="question-helper">Do you remember this word?</p>
          <div class="question-word-with-play">
            <h2><%= @word.word %></h2>
            <span class="question-audio-pronunciation"><%= @word.pronunciation.presence || "—" %></span>
            <button
              type="button"
              class="button button-secondary pronunciation-play pronunciation-icon-button"
              aria-label="Play sound"
              title="Play sound"
              data-pronunciation-play
              data-word-text="<%= @word.word %>">
              &#128266;
            </button>
          </div>

          <div class="word-flash-example-reveal">
            <button
              type="button"
              class="button button-secondary word-flash-example-toggle"
              <%= tag.attributes(disabled: true) unless flash_has_example %>
              <% if flash_has_example %>
                data-word-flash-example-toggle
                data-label-show="Show example sentence"
                data-label-hide="Hide example sentence"
                aria-expanded="false"
                aria-controls="word-flash-example-panel"
              <% end %>>
              <%= flash_has_example ? "Show example sentence" : "No example sentence yet" %>
            </button>
            <% if flash_has_example %>
              <div
                id="word-flash-example-panel"
                class="word-flash-example-panel"
                hidden
                role="region"
                aria-labelledby="word-flash-example-heading"
                aria-hidden="true">
                <p id="word-flash-example-heading" class="word-flash-example-heading">Example sentence</p>
                <div class="word-flash-example-body"><%= simple_format(flash_example_sentence) %></div>
              </div>
            <% end %>
          </div>
        </div>

        <aside class="recall-sidebar">
          <%= form_with model: @word_self_recall_record, url: word_self_recall_records_path, class: "answer-form recall-panel-form" do |form| %>
            <%= hidden_field_tag :reviewed_word_ids, @reviewed_word_ids.join(",") if @reviewed_word_ids.present? %>
            <%= form.hidden_field :word_id, value: @word.id %>

            <div class="recall-panel">
              <div class="recall-panel-title">Your answer</div>
              <%= form.button "Remember this",
                              name: "word_self_recall_record[is_correct]",
                              value: "true",
                              type: "submit",
                              class: "recall-btn recall-btn-success" %>
              <%= form.button "Don't remember this",
                              name: "word_self_recall_record[is_correct]",
                              value: "false",
                              type: "submit",
                              class: "recall-btn recall-btn-secondary" %>
            </div>
          <% end %>
        </aside>
      </section>
    </section>
  <% else %>
    <section class="completion-card">
      <p class="eyebrow">Daily Review</p>
      <h2>All caught up</h2>
      <p>You have recalled all words due today.</p>
      <%= link_to "Add new word", new_word_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>

<script>
  document.addEventListener("click", function(event) {
    const button = event.target.closest("[data-pronunciation-play]");
    if (!button) return;

    const text = (button.dataset.wordText || "").trim();
    if (!text) return;

    if (window.speechSynthesis) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "en-US";
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }
  });

  document.addEventListener("click", function(event) {
    const toggle = event.target.closest("[data-word-flash-example-toggle]");
    if (!toggle || toggle.disabled) return;

    const panelId = toggle.getAttribute("aria-controls");
    if (!panelId) return;

    const panel = document.getElementById(panelId);
    if (!panel) return;

    const showLabel = (toggle.dataset.labelShow || "").trim() || "Show example sentence";
    const hideLabel = (toggle.dataset.labelHide || "").trim() || "Hide example sentence";
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    if (isOpen) {
      panel.hidden = true;
      panel.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.textContent = showLabel;
    } else {
      panel.hidden = false;
      panel.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.textContent = hideLabel;
    }
  });
</script>
