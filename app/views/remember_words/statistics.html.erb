<% content_for :title, "Statistics" %>

<main class="remember-page statistics-page">
  <header class="remember-header">
    <div>
      <p class="eyebrow">Daily Review</p>
      <h1>Statistics</h1>
      <p class="remember-progress-meta">
        Remembered <%= @stats[:remembered_words] %> / <%= @stats[:total_words] %>
        · Completion <%= @stats[:completion_rate_percent] %>%
        · Today <%= @stats[:reviews_today] %> reviews
      </p>
    </div>
    <div class="remember-header-actions">
      <%= link_to "Back to Review", root_path, class: "button button-secondary" %>
      <%= link_to "Today Words", today_words_path, class: "button button-secondary" %>
    </div>
  </header>

  <section class="statistics-summary-grid">
    <article class="statistics-summary-card">
      <p class="eyebrow">Vocabulary</p>
      <p class="statistics-value"><%= @stats[:total_words] %></p>
      <p class="statistics-label">Total words</p>
    </article>

    <article class="statistics-summary-card">
      <p class="eyebrow">Completed</p>
      <p class="statistics-value"><%= @stats[:remembered_words] %></p>
      <p class="statistics-label">remember_times >= 6</p>
    </article>

    <article class="statistics-summary-card">
      <p class="eyebrow">Review Volume</p>
      <p class="statistics-value"><%= @stats[:reviews_last_7_days] %></p>
      <p class="statistics-label">Reviews in last 7 days</p>
    </article>

    <article class="statistics-summary-card">
      <p class="eyebrow">Consistency</p>
      <p class="statistics-value"><%= @stats[:active_days_last_30_days] %></p>
      <p class="statistics-label">Active review days in last 30 days</p>
    </article>
  </section>

  <section class="statistics-heatmap statistics-heatmap--floating-tooltip" aria-label="Daily review heatmap">
    <div class="statistics-heatmap-header">
      <p class="eyebrow">This year</p>
      <p class="statistics-heatmap-today">Today: <strong><%= @stats[:reviews_today] %></strong> reviews</p>
      <p class="statistics-legend">
        Less
        <span class="statistics-heatmap-cell statistics-heatmap-level-0" aria-hidden="true"></span>
        <span class="statistics-heatmap-cell statistics-heatmap-level-1" aria-hidden="true"></span>
        <span class="statistics-heatmap-cell statistics-heatmap-level-2" aria-hidden="true"></span>
        <span class="statistics-heatmap-cell statistics-heatmap-level-3" aria-hidden="true"></span>
        <span class="statistics-heatmap-cell statistics-heatmap-level-4" aria-hidden="true"></span>
        More
      </p>
    </div>

    <div class="statistics-heatmap-scroll">
      <div class="statistics-heatmap-grid">
        <% @heatmap_dates.each do |date| %>
          <% count = @stats[:daily_review_counts][date] %>
          <% level = RememberWordsStatistics.heat_level(count: count, max_count: @stats[:heatmap_max_count]) %>
          <% cell_classes = ["statistics-heatmap-cell", "statistics-heatmap-level-#{level}"] %>
          <% cell_classes << "statistics-heatmap-cell-active" if count.positive? %>
          <% tooltip = "#{date.iso8601}: #{count} reviews" %>

          <span
            class="<%= cell_classes.join(" ") %>"
            data-tooltip="<%= tooltip %>"
            aria-label="<%= tooltip %>">
          </span>
        <% end %>
      </div>
    </div>
  </section>
</main>

<script>
(function () {
  var anchoredCell = null;

  function ensureTooltipEl() {
    var el = document.getElementById("statistics-heatmap-tooltip");
    if (el) return el;
    el = document.createElement("div");
    el.id = "statistics-heatmap-tooltip";
    el.className = "statistics-heatmap-floating-tooltip";
    el.setAttribute("role", "tooltip");
    document.body.appendChild(el);
    return el;
  }

  function positionTooltip(cell, tip) {
    var r = cell.getBoundingClientRect();
    var pad = 8;
    var cx = r.left + r.width / 2;
    var tw = tip.offsetWidth;
    var th = tip.offsetHeight;
    var half = tw / 2;
    cx = Math.max(pad + half, Math.min(cx, window.innerWidth - half - pad));
    var top = r.top - th - pad;
    if (top < pad) {
      top = r.bottom + pad;
    }
    tip.style.left = cx + "px";
    tip.style.top = top + "px";
    tip.style.transform = "translateX(-50%)";
  }

  function repositionIfVisible() {
    var tip = document.getElementById("statistics-heatmap-tooltip");
    if (!tip || !tip.classList.contains("is-visible") || !anchoredCell) return;
    positionTooltip(anchoredCell, tip);
  }

  function initStatisticsHeatmapTooltip() {
    var section = document.querySelector(".statistics-heatmap--floating-tooltip");
    if (!section) return;
    var grid = section.querySelector(".statistics-heatmap-grid");
    if (!grid) return;

    var tip = ensureTooltipEl();
    if (grid.dataset.heatmapTooltipBound === "1") return;
    grid.dataset.heatmapTooltipBound = "1";

    function show(cell) {
      var text = cell.getAttribute("data-tooltip");
      if (!text) return;
      anchoredCell = cell;
      tip.textContent = text;
      tip.classList.add("is-visible");
      positionTooltip(cell, tip);
    }

    function hide() {
      anchoredCell = null;
      tip.classList.remove("is-visible");
      tip.textContent = "";
    }

    grid.querySelectorAll(".statistics-heatmap-cell[data-tooltip]").forEach(function (cell) {
      cell.addEventListener("mouseenter", function () {
        show(cell);
      });
      cell.addEventListener("mouseleave", hide);
    });

    if (!window.__statisticsHeatmapTooltipGlobalListeners) {
      window.__statisticsHeatmapTooltipGlobalListeners = true;
      window.addEventListener("scroll", repositionIfVisible, true);
      window.addEventListener("resize", repositionIfVisible);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStatisticsHeatmapTooltip);
  } else {
    initStatisticsHeatmapTooltip();
  }
})();
</script>
