<% content_for :title, @current_word.present? ? "#{@current_word.word} · Browse" : "Browse Words" %>

<main class="remember-page word-browse-page">
  <header class="remember-header">
    <div>
      <p class="eyebrow">Browse</p>
      <h1>Browse words</h1>
      <p class="remember-subtitle">Read full meanings in dictionary order. Use the arrows or keyboard ← → to move.</p>
    </div>
    <div class="remember-header-actions word-browse-header-actions">
      <%= link_to "Daily review", root_path, class: "button button-secondary" %>
      <%= link_to "All words", words_path, class: "button button-secondary" %>
      <% if @current_word.present? %>
        <%= link_to "Edit word", edit_word_path(@current_word), class: "button button-secondary" %>
      <% end %>
    </div>
  </header>

  <% if @current_word.present? %>
    <section class="remember-progress-card word-browse-progress" aria-label="Browse progress">
      <div class="word-browse-progress-top">
        <p class="eyebrow">Progress</p>
        <p class="remember-progress-main">Word <%= @current_index + 1 %> of <%= @total_count %></p>
      </div>
      <div class="remember-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @progress_percent %>" aria-label="Position in word list">
        <div class="remember-progress-fill" style="width: <%= @progress_percent %>%"></div>
      </div>
    </section>

    <section class="recall-card word-browse-card" aria-label="Current word">
      <div class="question-block word-browse-word-block">
        <p class="question-helper">Word</p>
        <div class="word-browse-word-line">
          <h2><%= @current_word.word %></h2>
          <span class="question-audio-pronunciation word-browse-pronunciation-inline"><%= @current_word.pronunciation.presence || "—" %></span>
          <button
            type="button"
            class="button button-secondary pronunciation-play pronunciation-icon-button"
            aria-label="Play sound"
            title="Play sound"
            data-pronunciation-play
            data-word-text="<%= @current_word.word %>">
            &#128266;
          </button>
        </div>
      </div>

      <div class="word-browse-meanings">
        <article class="word-browse-meaning-panel" aria-labelledby="browse-en-heading">
          <h3 class="word-browse-meaning-heading" id="browse-en-heading">English meaning</h3>
          <div class="word-browse-meaning-body">
            <%= simple_format(@current_word.english_meaning) %>
          </div>
        </article>
        <article class="word-browse-meaning-panel" aria-labelledby="browse-zh-heading">
          <h3 class="word-browse-meaning-heading" id="browse-zh-heading">Chinese meaning</h3>
          <div class="word-browse-meaning-body">
            <%= simple_format(@current_word.chinese_meaning) %>
          </div>
        </article>
      </div>

      <nav class="browse-nav word-browse-nav" aria-label="Previous and next word">
        <% if @prev_word %>
          <%= link_to word_browse_path(word_id: @prev_word.id),
                      class: "button button-secondary button-large browse-nav-btn browse-nav-prev",
                      data: { browse_nav: "prev" } do %>
            <span class="browse-nav-btn-label" aria-hidden="true">←</span>
            <span>Previous</span>
          <% end %>
        <% else %>
          <span class="browse-nav-placeholder browse-nav-btn button button-secondary button-large" aria-disabled="true">
            <span class="browse-nav-btn-label" aria-hidden="true">←</span>
            <span>Previous</span>
          </span>
        <% end %>

        <% if @next_word %>
          <%= link_to word_browse_path(word_id: @next_word.id),
                      class: "button button-primary button-large browse-nav-btn browse-nav-next",
                      data: { browse_nav: "next" } do %>
            <span>Next word</span>
            <span class="browse-nav-btn-label" aria-hidden="true">→</span>
          <% end %>
        <% else %>
          <span class="browse-nav-placeholder browse-nav-btn button button-primary button-large browse-nav-next is-disabled" aria-disabled="true">
            <span>Next word</span>
            <span class="browse-nav-btn-label" aria-hidden="true">→</span>
          </span>
        <% end %>
      </nav>
    </section>
  <% else %>
    <section class="completion-card">
      <p class="eyebrow">Browse</p>
      <h2>No words yet</h2>
      <p>Add some words to start browsing.</p>
      <%= link_to "Add new word", new_word_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>

<script>
  document.addEventListener("click", function(event) {
    const button = event.target.closest("[data-pronunciation-play]");
    if (!button) return;

    const text = (button.dataset.wordText || "").trim();
    if (!text) return;

    if (window.speechSynthesis) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "en-US";
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }
  });

  document.addEventListener("keydown", function(event) {
    if (event.defaultPrevented) return;
    const tag = (event.target && event.target.tagName) || "";
    if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || event.target.isContentEditable) return;

    const prev = document.querySelector('[data-browse-nav="prev"]');
    const next = document.querySelector('[data-browse-nav="next"]');

    if (event.key === "ArrowLeft" && prev) {
      event.preventDefault();
      prev.click();
    } else if (event.key === "ArrowRight" && next) {
      event.preventDefault();
      next.click();
    }
  });
</script>
