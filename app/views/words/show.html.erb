<% content_for :title, @word.word %>

<% if params[:flash_remember].present? %>
  <% flash_example_sentence = @word.example_sentence.to_s.strip %>
  <% flash_has_example = flash_example_sentence.present? %>
  <main class="remember-page word-show-flash-remember-page">
    <header class="remember-header">
      <div>
        <p class="eyebrow">Daily Review</p>
        <h1>Word flash remember</h1>
        <p class="remember-subtitle">Meanings for this word. Continue the queue when you are ready.</p>
      </div>
      <div class="remember-header-actions">
        <%= link_to "Multiple choice review", multiple_choice_review_path, class: "button button-secondary" %>
        <%= link_to "Edit word", edit_word_path(@word), class: "button button-secondary" %>
      </div>
    </header>

    <% if flash[:notice].present? %>
      <p class="flash flash-notice"><%= flash[:notice] %></p>
    <% end %>

    <section class="recall-card word-show-flash-reveal-card" aria-label="Word meanings">
      <div class="question-block">
        <p class="question-helper">Word</p>
        <div class="question-word-with-play">
          <h2><%= @word.word %></h2>
          <span class="question-audio-pronunciation"><%= @word.pronunciation.presence || "—" %></span>
          <button
            type="button"
            class="button button-secondary pronunciation-play pronunciation-icon-button"
            aria-label="Play sound"
            title="Play sound"
            data-pronunciation-play
            data-word-text="<%= @word.word %>">
            &#128266;
          </button>
        </div>
      </div>

      <dl class="word-detail">
        <dt>English meaning</dt>
        <dd><%= simple_format(@word.english_meaning) %></dd>
        <dt>Chinese meaning</dt>
        <dd><%= simple_format(@word.chinese_meaning) %></dd>
      </dl>

      <div class="word-flash-example-reveal">
        <button
          type="button"
          class="button button-secondary word-flash-example-toggle"
          <%= tag.attributes(disabled: true) unless flash_has_example %>
          <% if flash_has_example %>
            data-word-flash-example-toggle
            data-label-show="Show example sentence"
            data-label-hide="Hide example sentence"
            aria-expanded="false"
            aria-controls="word-flash-example-panel"
          <% end %>>
          <%= flash_has_example ? "Show example sentence" : "No example sentence yet" %>
        </button>
        <% if flash_has_example %>
          <div
            id="word-flash-example-panel"
            class="word-flash-example-panel"
            hidden
            role="region"
            aria-labelledby="word-flash-example-heading"
            aria-hidden="true">
            <p id="word-flash-example-heading" class="word-flash-example-heading">Example sentence</p>
            <div class="word-flash-example-body"><%= simple_format(flash_example_sentence) %></div>
          </div>
        <% end %>
      </div>

      <div class="actions">
        <%= link_to "Next word",
                    root_path(reviewed_word_ids: params[:reviewed_word_ids]),
                    class: "button button-primary button-large" %>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener("click", function(event) {
      const button = event.target.closest("[data-pronunciation-play]");
      if (!button) return;

      const text = (button.dataset.wordText || "").trim();
      if (!text) return;

      if (window.speechSynthesis) {
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "en-US";
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(utterance);
      }
    });

    document.addEventListener("click", function(event) {
      const toggle = event.target.closest("[data-word-flash-example-toggle]");
      if (!toggle || toggle.disabled) return;

      const panelId = toggle.getAttribute("aria-controls");
      if (!panelId) return;

      const panel = document.getElementById(panelId);
      if (!panel) return;

      const showLabel = (toggle.dataset.labelShow || "").trim() || "Show example sentence";
      const hideLabel = (toggle.dataset.labelHide || "").trim() || "Hide example sentence";
      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        panel.hidden = true;
        panel.setAttribute("aria-hidden", "true");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = showLabel;
      } else {
        panel.hidden = false;
        panel.setAttribute("aria-hidden", "false");
        toggle.setAttribute("aria-expanded", "true");
        toggle.textContent = hideLabel;
      }
    });
  </script>
<% else %>
  <main class="remember-page word-show-page">
    <header class="remember-header">
      <div class="word-show-header-lead">
        <p class="eyebrow">Word</p>
        <div class="question-word-with-play word-show-headword-row">
          <h1 class="word-show-headword-title"><%= @word.word %></h1>
          <span class="question-audio-pronunciation"><%= @word.pronunciation.presence || "—" %></span>
          <%= tag.button(
                type: "button",
                class: "button button-secondary pronunciation-play pronunciation-icon-button",
                aria: { label: "Play sound" },
                title: "Play sound",
                data: { pronunciation_play: true, word_text: @word.word }
              ) do %>
            &#128266;
          <% end %>
        </div>
      </div>
      <div class="remember-header-actions">
        <%= link_to "All words", words_path, class: "button button-secondary" %>
        <%= link_to "Edit word", edit_word_path(@word), class: "button button-primary" %>
      </div>
    </header>

    <% if flash[:notice].present? %>
      <p class="flash flash-notice"><%= flash[:notice] %></p>
    <% end %>

    <section class="recall-card word-show-meanings" aria-labelledby="word-meanings-label">
      <p id="word-meanings-label" class="question-helper">Meanings</p>
      <dl class="word-detail word-detail-show">
        <dt>English</dt>
        <dd><%= simple_format(@word.english_meaning.presence || "—") %></dd>
        <dt>Chinese</dt>
        <dd><%= simple_format(@word.chinese_meaning.presence || "—") %></dd>
        <dt>Example sentence</dt>
        <dd><%= simple_format(@word.example_sentence.presence || "—") %></dd>
      </dl>

      <footer class="word-show-card-footer">
        <%= button_to "Delete word",
                      word_path(@word),
                      method: :delete,
                      class: "button button-danger",
                      form: { data: { turbo_confirm: "Delete this word?" } } %>
      </footer>
    </section>
  </main>

  <script>
    document.addEventListener("click", function(event) {
      const button = event.target.closest("[data-pronunciation-play]");
      if (!button) return;

      const text = (button.dataset.wordText || "").trim();
      if (!text) return;

      if (window.speechSynthesis) {
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "en-US";
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(utterance);
      }
    });
  </script>
<% end %>
