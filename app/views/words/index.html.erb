<% content_for :title, "Words" %>

<h1>Words</h1>

<p class="toolbar">
  <%= link_to "Add new word", new_word_path, class: "button button-primary" %>
</p>

<% if @words.any? %>
  <table class="word-table">
    <thead>
      <tr>
        <th>Word</th>
        <th>English meaning</th>
        <th>Chinese meaning</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @words.each do |word| %>
        <tr>
          <td>
            <div class="question-audio-row word-table-word-play">
              <strong><%= word.word %></strong>
              <%= tag.button(
                    type: "button",
                    class: "button button-secondary pronunciation-play pronunciation-icon-button",
                    aria: { label: "Play sound" },
                    title: "Play sound",
                    data: { pronunciation_play: true, word_text: word.word }
                  ) do %>
                &#128266;
              <% end %>
            </div>
          </td>
          <td><%= truncate(word.english_meaning, length: 80) %></td>
          <td><%= truncate(word.chinese_meaning, length: 80) %></td>
          <td class="actions-cell">
            <%= link_to "Show", word_path(word), class: "button button-small" %>
            <%= link_to "Edit", edit_word_path(word), class: "button button-small" %>
            <%= button_to "Delete", word_path(word), method: :delete, class: "button button-small button-danger", form: { data: { turbo_confirm: "Delete this word?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No words yet. <%= link_to "Add your first word", new_word_path %>.</p>
<% end %>

<script>
  document.addEventListener("click", function(event) {
    const button = event.target.closest("[data-pronunciation-play]");
    if (!button) return;

    const text = (button.dataset.wordText || "").trim();
    if (!text) return;

    if (window.speechSynthesis) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "en-US";
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }
  });
</script>
